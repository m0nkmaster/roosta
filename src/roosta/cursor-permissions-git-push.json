{
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Shell(git:push origin main)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Shell(gh:pr create*)",
      "Shell(gh:issue create*)",
      "Shell(gh:workflow run*)",
      "Shell(gh:release create*)",
      "Shell(curl)",
      "Shell(wget)",
      "Mcp(*:*create*)",
      "Mcp(*:*update*)",
      "Mcp(*:*delete*)",
      "Mcp(*:*move*)",
      "Mcp(*:*duplicate*)",
      "Mcp(*:*send*)",
      "Mcp(*:*post*)",
      "Mcp(*:*comment*)",
      "Mcp(*:*trigger*)",
      "Mcp(*:*deploy*)"
    ]
  }
}
