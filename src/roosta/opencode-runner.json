{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "gh pr create *": "deny",
      "gh issue create *": "deny",
      "gh workflow run *": "deny",
      "gh release create *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    },
    "*_create*": "deny",
    "*_update*": "deny",
    "*_delete*": "deny",
    "*_move*": "deny",
    "*_duplicate*": "deny",
    "*_send*": "deny",
    "*_post*": "deny",
    "*_comment*": "deny",
    "*_trigger*": "deny",
    "*_deploy*": "deny"
  }
}
